{
  "schemaVersion": 1,
  "id": "rem",
  "name": "Rem",
  "description": "Rem character pack using the supplied 8×8 spritesheet.",
  "sprite": "sprite.png",
  "preview": "sprite.png",
  "frame": {
    "width": 768,
    "height": 832
  },
  "columns": 8,
  "states": {
    "idle": { "row": 0, "frames": 6, "interval": 900 },
    "runningRight": { "row": 1, "frames": 8, "interval": 110 },
    "runningLeft": { "row": 2, "frames": 8, "interval": 110 },
    "waving": { "row": 3, "frames": 4, "interval": 220 },
    "jumping": { "row": 4, "frames": 5, "interval": 180 },
    "failed": { "row": 5, "frames": 8, "interval": 220 },
    "running": { "row": 6, "frames": 6, "interval": 120 },
    "review": { "row": 7, "frames": 6, "interval": 500 }
  },
  "automaticActions": ["review", "waving", "jumping"],
  "clickActions": ["waving", "review", "jumping", "failed"],
  "staticExpressions": [
    { "state": "idle", "frame": 0 },
    { "state": "idle", "frame": 1 },
    { "state": "idle", "frame": 2 },
    { "state": "idle", "frame": 3 },
    { "state": "idle", "frame": 4 },
    { "state": "idle", "frame": 5 },
    { "state": "waving", "frame": 1 },
    { "state": "review", "frame": 1 },
    { "state": "failed", "frame": 1 }
  ]
}
